<Application x:Class="OpenRevo.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="LucidePaneToggleStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <FontIcon FontFamily="ms-appx:///Assets/Lucide.ttf#lucide" Glyph="&#xE115;" FontSize="20" IsTextScaleFactorEnabled="False" AutomationProperties.AccessibilityView="Raw" />
    </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LucideCloseStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
      <FontIcon FontFamily="ms-appx:///Assets/Lucide.ttf#lucide" Glyph="&#xE1B2;" FontSize="16" IsTextScaleFactorEnabled="False" AutomationProperties.AccessibilityView="Raw" />
    </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SurfaceCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="SecondaryBodyStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="RootSurfaceStyle" TargetType="Grid">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
  </Style>
  </ResourceDictionary></Application.Resources>
</Application>
